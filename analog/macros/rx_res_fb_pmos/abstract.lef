    LAYER met1 ;
      RECT 0.345 7.435 1.130 17.250 ;
    LAYER met1 ;
      RECT 1.130 0.000 4.455 17.250 ;
    LAYER met1 ;
      RECT 4.455 0.000 5.230 0.320 ;
    LAYER met1 ;
      RECT 4.455 1.115 5.230 17.250 ;
    LAYER met1 ;
      RECT 5.115 0.000 5.890 13.060 ;
    LAYER met1 ;
      RECT 5.115 13.855 5.890 17.250 ;
    LAYER met1 ;
      RECT 5.890 0.000 8.755 17.250 ;
    LAYER met1 ;
      RECT 8.755 0.000 9.545 6.675 ;
    LAYER met1 ;
      RECT 8.755 7.415 9.545 17.250 ;
    LAYER met1 ;
