VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO rx_parallel_inv_macro
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN rx_parallel_inv_macro 0 0 ;
  SIZE 8.190 BY 6.000 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 0.190 5.200 7.390 5.600 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 0.190 0.600 7.390 1.000 ;
    END
  END VSS
  PIN IN
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 0.190 2.700 2.390 2.900 ;
    END
  END IN
  PIN OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 2.390 2.050 5.390 2.300 ;
    END
  END OUT
  OBS
    LAYER met1 ;
      RECT 0.000 0.000 8.190 1.850 ;
      RECT 0.000 1.850 2.190 2.500 ;
      RECT 5.590 1.850 8.190 2.500 ;
      RECT 0.000 2.500 8.190 2.500 ;
      RECT 2.590 2.500 8.190 3.100 ;
      RECT 0.000 3.100 8.190 6.000 ;
    LAYER met2 ;
      RECT 0.000 0.000 8.190 6.000 ;
    LAYER met3 ;
      RECT 0.000 0.000 8.190 6.000 ;
    LAYER met4 ;
      RECT 0.000 0.000 8.190 0.400 ;
      RECT 7.590 0.400 8.190 1.200 ;
      RECT 0.000 1.200 8.190 5.000 ;
      RECT 7.590 5.000 8.190 5.800 ;
      RECT 0.000 5.800 8.190 6.000 ;
    LAYER met5 ;
      RECT 0.000 0.000 8.190 6.000 ;
  END
END rx_parallel_inv_macro
END LIBRARY
