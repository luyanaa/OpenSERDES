VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO tx_inv_chain_1_3_9
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN tx_inv_chain_1_3_9 0 0 ;
  SIZE 20.390 BY 6.020 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met4 ;
        RECT 0.190 5.110 20.190 5.510 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met4 ;
        RECT 0.190 0.510 20.190 0.910 ;
    END
  END VSS
  PIN IN
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 0.000 1.050 1.690 1.660 ;
    END
  END IN
  PIN OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 8.200 0.350 9.050 0.950 ;
    END
  END OUT
  OBS
    LAYER met2 ;
      RECT 0.000 0.000 20.390 6.020 ;
    LAYER met3 ;
      RECT 0.000 0.000 20.390 6.020 ;
    LAYER met5 ;
      RECT 0.000 0.000 20.390 6.020 ;
  END
END tx_inv_chain_1_3_9
