VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO tx_inv_chain_1_3_9
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN tx_inv_chain_1_3_9 0 0 ;
  SIZE 20.840 BY 12.945 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met1 ;
        RECT 9.305 12.750 9.610 12.925 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met1 ;
        RECT 8.450 0.000 8.680 0.195 ;
    END
  END VSS
  PIN IN
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 0.005 6.335 0.195 6.535 ;
    END
  END IN
  PIN OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 20.585 6.330 20.840 6.505 ;
    END
  END OUT
END tx_inv_chain_1_3_9
