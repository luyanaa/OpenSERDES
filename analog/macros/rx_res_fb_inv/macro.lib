library (sky130_analog_blackbox) {
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1mA" ;
  capacitive_load_unit (1, pf) ;
  cell (rx_res_fb_inv) {
    area : 164.8864 ;
    dont_touch : true ;
    pin (VDD) {
      direction : inout ;
      pg_type : primary_power ;
    }
    pin (VSS) {
      direction : inout ;
      pg_type : primary_ground ;
    }
    pin (IN) {
      direction : input ;
    }
    pin (OUT) {
      direction : output ;
    }
  }
}
