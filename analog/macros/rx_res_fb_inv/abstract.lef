VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;
MACRO rx_res_fb_inv
  CLASS BLOCK ;
  ORIGIN 0 0 ;
  FOREIGN rx_res_fb_inv 0 0 ;
  SIZE 9.915 BY 16.630 ;
  SYMMETRY X Y ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
    PORT
      LAYER met1 ;
        RECT 5.415 12.740 5.590 12.935 ;
    END
  END VDD
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met1 ;
        RECT 4.755 0.000 4.930 0.195 ;
    END
  END VSS
  PIN IN
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 0.645 6.325 0.830 6.515 ;
    END
  END IN
  PIN OUT
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER met1 ;
        RECT 9.055 6.355 9.245 6.495 ;
    END
  END OUT
END rx_res_fb_inv
END LIBRARY
